# Copy this file to .env and fill in the values.
# .env is ignored by git, so the password never goes into the repository.

# Password of the public demo account customer@practicesoftwaretesting.com.
# It is listed in the README of https://github.com/testsmith-io/practice-software-testing
# Tests tagged @auth are skipped while this is empty.
CUSTOMER_PASSWORD=

# Optional: point the tests at another copy of the site (for example a local Docker copy).
# BASE_URL=https://practicesoftwaretesting.com
# API_URL=https://api.practicesoftwaretesting.com
