{
  "name": "nitx-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript end-to-end and API tests on Practice Software Testing (Nitx QA hiring test, Section 08)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
